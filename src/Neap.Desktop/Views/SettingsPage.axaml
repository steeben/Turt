<UserControl
    x:Class="Neap.Desktop.Views.SettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <c:PageView>
        <StackPanel>

            <TextBlock loc:Uid.Value="Settings_Title" Classes="pagetitle" />

            <!--
                Neap itself, and whether it is up to date, first: the
                update banner and the notice by the clock both lead
                here, so what they promise is the first thing seen. On
                the same lit panel as the headset's controls.
            -->
            <Border Classes="card">
                <Grid
                    x:Name="NeapCard"
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="{StaticResource NeapSpaceL}">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource NeapSpaceL}">
                        <Image
                            Width="56"
                            Height="56"
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="avares://Neap.Desktop/Assets/logo.png" />
                        <StackPanel Grid.Column="1" Spacing="{StaticResource NeapSpaceS}">
                            <StackPanel Classes="gaprow" Spacing="{StaticResource NeapSpaceM}">
                                <TextBlock
                                    x:Name="AppName"
                                    VerticalAlignment="Bottom"
                                    Classes="cardtitle" />
                                <TextBlock
                                    x:Name="AppVersion"
                                    Margin="0,0,0,4"
                                    VerticalAlignment="Bottom"
                                    Classes="label"
                                    IsVisible="False" />
                            </StackPanel>

                            <!-- Said when it changes, not as a download's percentage ticks over. -->
                            <TextBlock
                                x:Name="UpdateStatus"
                                Classes="secondary"
                                IsVisible="False" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        x:Name="UpdateActions"
                        Grid.Row="1"
                        Classes="gaprow">
                        <Button
                            x:Name="WhatsNew"
                            loc:Uid.Value="Settings_UpdateNotes"
                            IsVisible="False" />
                        <Button x:Name="DownloadPage" IsVisible="False" />
                        <Button x:Name="UpdateButton" />
                    </StackPanel>

                </Grid>
            </Border>

            <StackPanel Margin="{StaticResource NeapSectionGap}" Spacing="{StaticResource NeapSpaceS}">
                <c:SettingsCard
                    x:Name="CheckForUpdatesCard"
                    loc:Uid.Value="Settings_CheckForUpdates"
                    Icon="{StaticResource IconUpdate}">
                    <ToggleSwitch x:Name="CheckForUpdates" />
                </c:SettingsCard>
                <!--
                    Starting with the system is left out where the system has no
                    way to do it.
                -->
                <c:SettingsCard
                    x:Name="StartCard"
                    loc:Uid.Value="Settings_StartWithWindows"
                    Icon="{StaticResource IconPower}">
                    <ToggleSwitch x:Name="StartWhenSignedIn" />
                </c:SettingsCard>
                <!-- The panel is opened by the icon, so it and its look are left out where there is no icon. -->
                <c:SettingsCard
                    x:Name="MiniCard"
                    loc:Uid.Value="Settings_MiniPanel"
                    Icon="{StaticResource IconControls}">
                    <ToggleSwitch x:Name="MiniPanelSwitch" />
                </c:SettingsCard>
                <c:SettingsCard
                    x:Name="LookCard"
                    loc:Uid.Value="Settings_MiniPanelLook"
                    Icon="{StaticResource IconControls}">
                    <Border Classes="segmented" loc:Uid.Value="Settings_MiniPanelLookChoice">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                x:Name="LookStandard"
                                loc:Uid.Value="Settings_LookStandard"
                                GroupName="PanelLook"
                                Theme="{StaticResource SegmentButton}" />
                            <RadioButton
                                x:Name="LookFrosty"
                                loc:Uid.Value="Settings_LookFrosty"
                                GroupName="PanelLook"
                                Theme="{StaticResource SegmentButton}" />
                        </StackPanel>
                    </Border>
                </c:SettingsCard>
                <c:SettingsCard loc:Uid.Value="Settings_Theme" Icon="{StaticResource IconTheme}">
                    <Border Classes="segmented" loc:Uid.Value="Settings_ThemeChoice">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                x:Name="ThemeSystem"
                                loc:Uid.Value="Settings_ThemeSystem"
                                GroupName="Theme"
                                Theme="{StaticResource SegmentButton}" />
                            <RadioButton
                                x:Name="ThemeLight"
                                loc:Uid.Value="Settings_ThemeLight"
                                GroupName="Theme"
                                Theme="{StaticResource SegmentButton}" />
                            <RadioButton
                                x:Name="ThemeDark"
                                loc:Uid.Value="Settings_ThemeDark"
                                GroupName="Theme"
                                Theme="{StaticResource SegmentButton}" />
                        </StackPanel>
                    </Border>
                </c:SettingsCard>
                <!-- What the icon shows, also left out where there is no icon. -->
                <c:SettingsCard
                    x:Name="TrayIconCard"
                    loc:Uid.Value="Settings_TrayIcon"
                    Icon="{StaticResource IconCharging}">
                    <!-- Five choices are too many for a row of segments, so they are listed under the name. -->
                    <c:SettingsCard.Below>
                        <StackPanel
                            x:Name="TrayIconOptions"
                            Margin="0,8,0,0"
                            loc:Uid.Value="Settings_TrayIconChoice"
                            Spacing="{StaticResource NeapSpaceS}">
                            <RadioButton
                                x:Name="TrayIconLogo"
                                loc:Uid.Value="Settings_TrayIconLogo"
                                GroupName="TrayIcon"
                                Theme="{StaticResource ChoiceRow}" />
                            <RadioButton
                                x:Name="TrayIconBattery"
                                loc:Uid.Value="Settings_TrayIconBattery"
                                GroupName="TrayIcon"
                                Theme="{StaticResource ChoiceRow}" />
                            <RadioButton
                                x:Name="TrayIconPercentage"
                                loc:Uid.Value="Settings_TrayIconPercentage"
                                GroupName="TrayIcon"
                                Theme="{StaticResource ChoiceRow}" />
                            <RadioButton
                                x:Name="TrayIconHeadsetBattery"
                                loc:Uid.Value="Settings_TrayIconHeadsetBattery"
                                GroupName="TrayIcon"
                                Theme="{StaticResource ChoiceRow}" />
                            <RadioButton
                                x:Name="TrayIconHeadsetPercentage"
                                loc:Uid.Value="Settings_TrayIconHeadsetPercentage"
                                GroupName="TrayIcon"
                                Theme="{StaticResource ChoiceRow}" />
                        </StackPanel>
                    </c:SettingsCard.Below>
                </c:SettingsCard>
            </StackPanel>

            <!-- Left out where the system does not let the app choose its defaults. -->
            <StackPanel x:Name="SoundDevices">
                <TextBlock loc:Uid.Value="Settings_SoundDevicesHeading" Classes="sectionheader" />
                <StackPanel Spacing="{StaticResource NeapSpaceS}">
                    <c:SettingsCard loc:Uid.Value="Settings_SoundFollows" Icon="{StaticResource IconDevice}">
                        <ToggleSwitch x:Name="SoundFollows" />
                    </c:SettingsCard>
                    <c:SettingsCard
                        x:Name="SoundBackCard"
                        loc:Uid.Value="Settings_SoundBackTo"
                        Icon="{StaticResource IconVolume}">
                        <ComboBox x:Name="SoundBackTo" MinWidth="240" />
                    </c:SettingsCard>
                    <c:SettingsCard
                        x:Name="MicrophoneBackCard"
                        loc:Uid.Value="Settings_MicrophoneBackTo"
                        Icon="{StaticResource IconMicrophone}">
                        <ComboBox x:Name="MicrophoneBackTo" MinWidth="240" />
                    </c:SettingsCard>
                </StackPanel>
            </StackPanel>

            <TextBlock loc:Uid.Value="Settings_DiagnosticsHeading" Classes="sectionheader" />
            <StackPanel Spacing="{StaticResource NeapSpaceS}">
                <c:SettingsCard
                    x:Name="Record"
                    loc:Uid.Value="Settings_Record"
                    Icon="{StaticResource IconRecord}">
                    <StackPanel Classes="gaprow">
                        <Button x:Name="RecordHelp" loc:Uid.Value="Settings_RecordHelp" Classes="iconbutton">
                            <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconHelp}" />
                        </Button>
                        <Button
                            x:Name="ReportRecording"
                            loc:Uid.Value="Settings_RecordReport"
                            IsVisible="False" />
                        <Button x:Name="RecordButton" />
                    </StackPanel>
                </c:SettingsCard>
                <c:SettingsCard
                    x:Name="MapCard"
                    loc:Uid.Value="Settings_MapHeadset"
                    Icon="{StaticResource IconDevice}">
                    <Button x:Name="MapHeadset" Classes="iconbutton">
                        <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconLaunch}" />
                    </Button>
                </c:SettingsCard>
            </StackPanel>

            <!--
                Firmware edits stay out of sight until asked for: one can stop a
                headset starting. Not in this release at all; see FirmwareEdit.Released.
            -->
            <StackPanel x:Name="Advanced">
                <TextBlock loc:Uid.Value="Settings_AdvancedHeading" Classes="sectionheader" />
                <c:SettingsCard loc:Uid.Value="Settings_FirmwareEdits" Icon="{StaticResource IconWarning}">
                    <ToggleSwitch x:Name="FirmwareSwitch" />
                </c:SettingsCard>
            </StackPanel>

            <!-- What has to be said and nothing a card could say instead, last and quiet. -->
            <TextBlock
                loc:Uid.Value="Settings_Legal"
                MaxWidth="760"
                Margin="0,24,0,0"
                HorizontalAlignment="Left"
                Classes="caption secondary" />

        </StackPanel>
    </c:PageView>
</UserControl>
